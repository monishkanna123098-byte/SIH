# Automated declaration extraction (chunk 8). OPTIONAL.
#
# With no key set the feature is absent: the "Read declarations from image"
# button does not render and the manual path is completely unchanged. The app
# starts, runs and passes every test with this file absent.
#
# Copy to `.env` and fill in. `.env` is gitignored -- never commit a key, and
# never paste one into a form field, a template or a chat.

LM_VISION_PROVIDER=anthropic
LM_VISION_API_KEY=
LM_VISION_MODEL=claude-opus-5

# Optional. Leave unset to use the provider's own endpoint. Set only if the
# team routes through a gateway.
LM_VISION_BASE_URL=


# ---------------------------------------------------------------------------
# Serving. All optional; unset means the local-only defaults.
# ---------------------------------------------------------------------------
# 127.0.0.1 unless set. The Codespaces devcontainer sets 0.0.0.0 because the
# port-forwarding agent cannot reach a loopback-only socket.
LM_HOST=
LM_PORT=
# --reload is on unless this is 0.
LM_RELOAD=

# The two demo accounts' passwords are committed in app/db.py, which is fine on
# a laptop and not fine on a shared URL. Set BOTH before making a forwarded
# port public. The app prints a warning on startup if it is serving on a
# non-loopback interface while either is still the committed default.
LM_OFFICER_PASSWORD=
LM_SUPERVISOR_PASSWORD=
